PROJECT_NAME=OpenRunning
ENVIRONMENT=local
SECRET_KEY=openrunning-local-development-secret-key-32chars
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# URL pública del frontend (links de reset de contraseña y CORS)
FRONTEND_HOST=http://localhost:5173
# Orígenes CORS extra (separados por coma). FRONTEND_HOST se agrega solo.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8001

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=openrunning_db
POSTGRES_USER=openrunning
POSTGRES_PASSWORD=openrunning_dev_password

# Strava (opcional)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_REDIRECT_URI=http://localhost:8000/api/v1/sync/strava/callback

# SMTP para emails de reset de contraseña (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=OpenRunning